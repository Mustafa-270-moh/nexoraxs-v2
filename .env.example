# Shared environment contract for NexoraXS V2
# This file documents the intended cross-project variables.
# App-specific `.env.example` files can be added later inside each project.

APP_NAME=NexoraXS
APP_ENV=local
APP_BASE_DOMAIN=nexoraxs.test

WWW_APP_URL=https://www.nexoraxs.test
CORE_APP_URL=https://core.nexoraxs.test
SHOPS_APP_URL=https://shops.nexoraxs.test
ADMIN_APP_URL=https://admin.nexoraxs.test
API_URL=https://api.nexoraxs.test

SESSION_DOMAIN=.nexoraxs.test
SANCTUM_STATEFUL_DOMAINS=www.nexoraxs.test,core.nexoraxs.test,shops.nexoraxs.test,admin.nexoraxs.test,api.nexoraxs.test

POSTGRES_DB=nexoraxs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Reserved for later implementation work
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://www.nexoraxs.test,https://core.nexoraxs.test,https://shops.nexoraxs.test,https://admin.nexoraxs.test
