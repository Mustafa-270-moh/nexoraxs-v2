# Docker Compose
COMPOSE_PROJECT_NAME=nexoraxs-v2
APP_ENV_FILE=.env.production
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Laravel application
APP_NAME=nexoraxs-api
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_REAL_APP_KEY
APP_DEBUG=false
APP_URL=https://api.nexoraxs.com
TRUSTED_PROXIES=*

# Domain model
APP_BASE_DOMAIN=nexoraxs.com
WWW_APP_URL=https://www.nexoraxs.com
CORE_APP_URL=https://app.nexoraxs.com
SHOPS_APP_URL=https://shops.nexoraxs.com
ADMIN_APP_URL=https://admin.nexoraxs.com
API_URL=https://api.nexoraxs.com

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexoraxs
DB_USERNAME=nexoraxs
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

POSTGRES_DB=nexoraxs
POSTGRES_USER=nexoraxs
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

# Sessions and Sanctum cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nexoraxs.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=app.nexoraxs.com,shops.nexoraxs.com,admin.nexoraxs.com
CORS_ALLOWED_ORIGINS=https://app.nexoraxs.com,https://shops.nexoraxs.com,https://admin.nexoraxs.com

# Runtime stores
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis is included for future-ready cache and queue work.
# The current foundation still uses database-backed sessions, cache, and queues.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@nexoraxs.com
MAIL_FROM_NAME="${APP_NAME}"

# First boot helpers
WAIT_FOR_DATABASE=true
RUN_MIGRATIONS=true
RUN_SEEDERS=true
RUN_COMPOSER_INSTALL=false
CACHE_LARAVEL_CONFIG=true
